# Railway Scraper Service — scraping + market evidence collection only
PORT=8080
WORKER_ID=railway-scraper-1
POLL_MS=2000
MAX_RETRIES=3

# Queue access: set these in Railway Variables, never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Playwright / browser config
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright
SCRAPER_TIMEOUT_MS=25000
SCRAPER_MAX_EXTRA_PAGES=3
SCRAPER_USER_AGENT=

# Optional provider fallbacks
SCRAPE_DO_TOKEN=
BROWSERLESS_API_TOKEN=
SERPAPI_KEY=
SERPER_API_KEY=

# Optional Agent Reach market sensor layer.
# Set this in Render to let the API enqueue market-sensor jobs on Railway.
AGENT_REACH_MARKET_SENSOR_ENABLED=false
AGENT_REACH_COMPETITOR_URLS=4
AGENT_REACH_SENSOR_TIMEOUT_MS=90000
AGENT_REACH_MAX_URLS=8
AGENT_REACH_MAX_FEEDS=4
AGENT_REACH_FETCH_TIMEOUT_MS=25000
