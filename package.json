{
  "name": "daka-all-in-one",
  "version": "5.2.1",
  "description": "Daka Market Intelligence Spyer — analyse marché, concurrence, offre, funnel et décision business.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:worker": "cd railway-scraper && npm start",
    "dev": "nodemon server.js",
    "dev:worker": "cd railway-scraper && npm run start",
    "prod": "NODE_ENV=production node server.js",
    "prod:worker": "cd railway-scraper && npm start",
    "postinstall": "npx playwright install chromium --with-deps || echo 'Playwright install skipped'",
    "health": "node -e \"fetch('http://localhost:8080').then(r=>r.json()).then(d=>console.log('Status:',d.status,'| Uptime:',d.uptime)).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "pm2:start": "pm2 start server.js --name daka-all-in-one -i max",
    "pm2:stop": "pm2 stop daka-all-in-one",
    "pm2:restart": "pm2 restart daka-all-in-one",
    "pm2:logs": "pm2 logs daka-all-in-one",
    "pm2:monit": "pm2 monit",
    "check": "node -v && node --check server.js && node scripts/apply-render-routing-patch.cjs",
    "env:check": "node -e \"console.log({NODE_ENV:process.env.NODE_ENV||'development',PORT:process.env.PORT||'not-set'});\""
  },
  "keywords": [
    "seo",
    "ai-fusion",
    "daka-all-in-one",
    "scraping",
    "stealth"
  ],
  "author": {
    "name": "Daka Team",
    "url": "https://seo.mktnstrategix.com"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "ghost-cursor": "^1.4.2",
    "helmet": "^7.1.0",
    "i18n-iso-countries": "^7.14.0",
    "node-cache": "^5.1.2",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
